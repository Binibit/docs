{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Binibit Labs",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0369A1"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "introduction"
            ]
          },
          {
            "group": "General",
            "pages": [
              "general/base-url",
              "general/authentication",
              "general/rate-limits",
              "general/response-format",
              "general/timestamps",
              "general/errors"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/ticker-id-format",
              "reference/trading-pairs",
              "reference/supported-assets"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "verification",
              "changelog",
              "faq",
              "support"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Market Data",
            "pages": [
              "api-reference/tickers",
              "api-reference/orderbook",
              "api-reference/historical-trades",
              "api-reference/asset"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Exchange",
          "href": "https://binibit.com",
          "icon": "arrow-up-right-from-square"
        },
        {
          "anchor": "Status",
          "href": "https://status.binibit.com",
          "icon": "signal-bars"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/Binibit/docs",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:api@binibit.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Trade",
      "href": "https://binibit.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/binibit",
      "github": "https://github.com/Binibit",
      "telegram": "https://t.me/binibit"
    }
  },
  "description": "Ecosystem Docs: Binibit Exchange, BiniChain (EVM L1), BaiDEX (AI-managed DEX), Bini App, and BINI Token.",
  "favicon": "/images/logolisting.png",
  "logo": "/images/logobinibitdocs.jpeg",
  "appearance": {
    "default": "light",
    "strict": true
  }
}
